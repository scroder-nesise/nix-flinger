-- DRAGGABLE MAIN FRAME

-- =============================================

DraggingSlider = false

local Power = 30

local DRAG_THRESHOLD = 4

local frameMouseDown, frameDragging = false, false

local frameDragStart, frameStartPos = nil, nil



local dragSurfaces = {Frame, header, Title, gearBtn, div, hint}

for _, el in ipairs(dragSurfaces) do

    pcall(function()

        el.InputBegan:Connect(function(input)

            local t = input.UserInputType

            if (t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch)

            and not DraggingSlider then

                frameMouseDown  = true

                frameDragging   = false

                frameDragStart  = input.Position

                frameStartPos   = Frame.Position

            end

        end)

        el.InputEnded:Connect(function(input)

            local t = input.UserInputType

            if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then

                frameMouseDown = false

                frameDragging  = false

            end

        end)

    end)

end



UserInputService.InputChanged:Connect(function(input)

    local t = input.UserInputType

    if not frameMouseDown or DraggingSlider then return end

    if t ~= Enum.UserInputType.MouseMovement and t ~= Enum.UserInputType.Touch then return end

    local delta = input.Position - frameDragStart

    if not frameDragging and

    (math.abs(delta.X) > DRAG_THRESHOLD or math.abs(delta.Y) > DRAG_THRESHOLD) then

        frameDragging = true

    end

    if frameDragging then

        Frame.Position = UDim2.new(

            frameStartPos.X.Scale, frameStartPos.X.Offset + delta.X,

            frameStartPos.Y.Scale, frameStartPos.Y.Offset + delta.Y

        )

    end

end)



-- Slider logic

SliderFrame.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1

    or input.UserInputType == Enum.UserInputType.Touch then

        DraggingSlider = true

    end

end)

SliderFrame.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1

    or input.UserInputType == Enum.UserInputType.Touch then

        DraggingSlider = false

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if DraggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement

    or input.UserInputType == Enum.UserInputType.Touch) then

        local mousePos    = input.Position.X

        local sliderAbsPos = SliderFrame.AbsolutePosition.X

        local sliderWidth  = SliderFrame.AbsoluteSize.X

        local relative = math.clamp((mousePos - sliderAbsPos) / sliderWidth, 0, 1)

        local min = _G.SliderMin or 1

        local max = _G.SliderMax or 250

        Power = math.floor(min + relative * (max - min))

        Fill.Size      = UDim2.new(relative, 0, 1, 0)

        Label.Text     = "Power: " .. Power

        powerBadge.Text = tostring(Power)

    end

end)



