local function makeBox(default, yPos, onChanged)

    local b = Instance.new("TextBox")

    b.Size             = UDim2.new(0.36, 0, 0, 22)

    b.Position         = UDim2.new(0.62, 0, 0, yPos)

    b.BackgroundColor3 = C.Input

    b.Text             = tostring(default)

    b.TextColor3       = C.TextOn

    b.TextSize         = 11

    b.Font             = Enum.Font.Gotham

    b.Parent           = sScroll

    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)

    b.FocusLost:Connect(function()

        local v = tonumber(b.Text)

        if v then

            onChanged(v)

        else

            b.Text = tostring(default)

        end

    end)

    return b

end



local function makeToggle(labelText, initState, yPos, onChanged)

    makeRow(labelText, yPos)

    local btn = Instance.new("TextButton")

    btn.Size             = UDim2.new(0.36, 0, 0, 22)

    btn.Position         = UDim2.new(0.62, 0, 0, yPos)

    btn.BackgroundColor3 = initState and Color3.fromRGB(20,40,28) or C.Surface

    btn.Text             = initState and "ON" or "OFF"

    btn.TextColor3       = initState and C.Green or C.Red

    btn.TextSize         = 11

    btn.Font             = Enum.Font.GothamBold

    btn.Parent           = sScroll

    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)

    local st = Instance.new("UIStroke", btn)

    st.Color = initState and C.Green or C.Border



    local state = initState

    btn.MouseButton1Click:Connect(function()

        state = not state

        TweenService:Create(btn, TweenInfo.new(0.12), {

            BackgroundColor3 = state and Color3.fromRGB(20,40,28) or C.Surface

        }):Play()

        TweenService:Create(st, TweenInfo.new(0.12), {

            Color = state and C.Green or C.Border

        }):Play()

        btn.Text       = state and "ON" or "OFF"

        btn.TextColor3 = state and C.Green or C.Red

        onChanged(state)

    end)

    return btn

end



