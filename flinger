-- ── Cooldown UI helper ──

local function setCooldownUI(active)

    TweenService:Create(cdDot,   TweenInfo.new(0.15), {

        BackgroundColor3 = active and C.Red or C.Green

    }):Play()

    TweenService:Create(ActionButton, TweenInfo.new(0.15), {

        BackgroundColor3 = active and C.Surface or C.Pink

    }):Play()

    cdLabel.Text       = active and "WAIT"  or "READY"

    cdLabel.TextColor3 = active and C.Red   or C.Green

    ActionButton.Text  = active and "⏳  cooling down…" or "✦  fling yourself!"

end



