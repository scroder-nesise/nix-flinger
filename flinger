Label.Parent = SliderFrame

local DraggingSlider = false
local Power = 30   -- 0 to 250

SliderFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        DraggingSlider = true
    end
end)

SliderFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        DraggingSlider = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if DraggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local mousePos = input.Position.X
        local sliderAbsPos = SliderFrame.AbsolutePosition.X
        local sliderWidth = SliderFrame.AbsoluteSize.X
        
        local relative = math.clamp((mousePos - sliderAbsPos) / sliderWidth, 0, 1)
        Power = math.floor(relative * 250)
        
        Fill.Size = UDim2.new(relative, 0, 1, 0)
        Label.Text = "fling power: " .. Power
    end
end)

-- ╔════════════════════════════════════════════╗
-- ║          ONE-TIME FLING BURST + LONG SPIN  ║
-- ╚════════════════════════════════════════════╝

local function doFlingBurst()
    if not character or not rootPart or not rootPart.Parent then return end
    
    humanoid.PlatformStand = true  -- Ragdoll mode during fling
    
    local intensity = Power / 25
    
    -- Big initial impulse with upward bias
    local flingDir = Vector3.new(
        math.random(-12,12) * intensity,
        math.random(15,28)  * intensity,   -- Strong up
        math.random(-12,12) * intensity
    )
    
    rootPart.Velocity = flingDir * 55
    
    rootPart.RotVelocity = Vector3.new(
        math.random(-500,500) * intensity,
        math.random(-800,800) * intensity,
        math.random(-500,500) * intensity
    )
    
    -- Extra wild spin kick
    rootPart.AssemblyAngularVelocity = Vector3.new(
        math.random(-1000,1000),
        math.random(-1500,1500),
        math.random(-1000,1000)
    )
    
    -- Longer air/spin time before slowdown (was ~1.4s, now ~2.8–3.5s)
    task.delay(2.8 + math.random() * 0.7, function()
        if not character or not rootPart or not rootPart.Parent then return end
        
        local tweenInfo = TweenInfo.new(
            1.2,                    -- Slowdown duration
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        )
        
        -- Gradually kill velocity and spin
        TweenService:Create(rootPart, tweenInfo, {
            Velocity = Vector3.new(),
            RotVelocity = Vector3.new(),
            AssemblyAngularVelocity = Vector3.new()
        }):Play()
        
        -- Restore control after slowdown
        task.delay(1.3, function()
            if humanoid and humanoid.Parent then
                humanoid.PlatformStand = false
            end
        end)
    end)
end

