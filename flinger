-- =============================================
--  BALLSOCKET RAGDOLL
--  Per-limb angle limits so it looks realistic.
--  Tag prefix lets cleanup find every constraint.
-- =============================================
local BSC_TAG = "__NixRagBSC"

local LIMITS = {
    Head          = { upper = 45,  twistL = -60, twistU = 60  },
    UpperTorso    = { upper = 45,  twistL = -30, twistU = 30  },
    LowerTorso    = { upper = 30,  twistL = -20, twistU = 20  },
    LeftUpperArm  = { upper = 90,  twistL = -90, twistU = 90  },
    RightUpperArm = { upper = 90,  twistL = -90, twistU = 90  },
    LeftLowerArm  = { upper = 80,  twistL = -10, twistU = 10  },
    RightLowerArm = { upper = 80,  twistL = -10, twistU = 10  },
    LeftHand      = { upper = 30,  twistL = -15, twistU = 15  },
    RightHand     = { upper = 30,  twistL = -15, twistU = 15  },
    LeftUpperLeg  = { upper = 80,  twistL = -45, twistU = 45  },
    RightUpperLeg = { upper = 80,  twistL = -45, twistU = 45  },
    LeftLowerLeg  = { upper = 90,  twistL = -10, twistU = 10  },
    RightLowerLeg = { upper = 90,  twistL = -10, twistU = 10  },
    LeftFoot      = { upper = 25,  twistL = -10, twistU = 10  },
    RightFoot     = { upper = 25,  twistL = -10, twistU = 10  },
}

local function applyRagdoll(char)
    if not char then return end
    for _, motor in ipairs(char:GetDescendants()) do
        if motor:IsA("Motor6D") and motor.Part0 and motor.Part1 then
            local p0   = motor.Part0
            local p1   = motor.Part1
            local name = p1.Name
            local lim  = LIMITS[name]

            motor.Enabled = false   -- disable joint so physics takes over

            -- Attachments at joint origin
            local a0 = Instance.new("Attachment")
            a0.Name   = BSC_TAG .. "_a0_" .. name
            a0.CFrame = motor.C0
            a0.Parent = p0

            local a1 = Instance.new("Attachment")
            a1.Name   = BSC_TAG .. "_a1_" .. name
            a1.CFrame = motor.C1
            a1.Parent = p1

            -- BallSocketConstraint
            local bsc       = Instance.new("BallSocketConstraint")
            bsc.Name        = BSC_TAG .. "_bsc_" .. name
            bsc.Attachment0 = a0
            bsc.Attachment1 = a1

            if lim then
                bsc.LimitsEnabled      = true
                bsc.UpperAngle         = lim.upper
                bsc.TwistLimitsEnabled = true
                bsc.TwistLowerAngle    = lim.twistL
                bsc.TwistUpperAngle    = lim.twistU
            else
                bsc.LimitsEnabled = false
            end

            bsc.Parent = p0
        end
    end
end

local function removeRagdoll(char)
    if not char then return end
    -- Destroy all BSC attachments and constraints
    for _, v in ipairs(char:GetDescendants()) do
        if v.Name:sub(1, #BSC_TAG) == BSC_TAG then
            v:Destroy()
        end
    end
    -- Re-enable all joints
    for _, motor in ipairs(char:GetDescendants()) do
        if motor:IsA("Motor6D") then
            motor.Enabled = true
        end
    end
end

