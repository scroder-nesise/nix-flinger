end)

UserInputService.InputChanged:Connect(function(input)
    if DraggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        local mousePos    = input.Position.X
        local sliderAbsPos = SliderFrame.AbsolutePosition.X
        local sliderWidth  = SliderFrame.AbsoluteSize.X

        local relative = math.clamp((mousePos - sliderAbsPos) / sliderWidth, 0, 1)
        Power = math.floor(relative * 250)

        Fill.Size  = UDim2.new(relative, 0, 1, 0)
        Label.Text = "fling power: " .. Power
    end
end)

-- ╔════════════════════════════════════════════╗
-- ║          ONE-TIME FLING BURST + LONG SPIN  ║
-- ╚════════════════════════════════════════════╝

-- FIX 5: Cooldown so spamming doesn't stack impulses
local onCooldown = false

local function doFlingBurst()
    if onCooldown then return end
    if not character or not rootPart or not rootPart.Parent then return end

    onCooldown = true

    local intensity = math.max(Power, 1) / 25

    -- FIX 4: Disable humanoid state for proper ragdoll on both R6 and R15
    humanoid.PlatformStand = true
    humanoid:ChangeState(Enum.HumanoidStateType.Physics)

    -- FIX 1: Use AssemblyLinearVelocity instead of deprecated .Velocity
    rootPart.AssemblyLinearVelocity = Vector3.new(
        math.random(-12, 12) * intensity,
        math.random(15,  28) * intensity,
        math.random(-12, 12) * intensity
    ) * 55

    -- FIX 1: Use AssemblyAngularVelocity for spin (single assignment, no conflict)
    rootPart.AssemblyAngularVelocity = Vector3.new(
        math.random(-1000, 1000) * intensity,
        math.random(-1500, 1500) * intensity,
        math.random(-1000, 1000) * intensity
    )

    -- FIX 2: Lerp angular velocity manually since TweenService can't tween it
    local spinDuration  = 2.8 + math.random() * 0.7
    local slowDuration  = 1.2
    local spinStart     = tick()
    local initialAngVel = rootPart.AssemblyAngularVelocity

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not rootPart or not rootPart.Parent then
            conn:Disconnect()
            return
        end

        local elapsed = tick() - spinStart

        if elapsed < spinDuration then
            -- Leave spin untouched during the air phase

        elseif elapsed < spinDuration + slowDuration then
            -- Lerp angular velocity to zero over slowDuration
            local t = (elapsed - spinDuration) / slowDuration
            t = t * t * (3 - 2 * t) -- smoothstep
            rootPart.AssemblyAngularVelocity = initialAngVel:Lerp(Vector3.zero, t)

        else
            -- Done: zero out and restore humanoid
            rootPart.AssemblyAngularVelocity = Vector3.zero
            conn:Disconnect()

            if humanoid and humanoid.Parent then
                humanoid.PlatformStand = false
                humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            end

            -- FIX 5: Release cooldown after full recovery
            task.delay(0.5, function()
                onCooldown = false
            end)
        end
    end)
end

