Label.Parent = SliderFrame

local DraggingSlider = false
local Power = 30   -- 0 to 100 (insane)

SliderFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        DraggingSlider = true
    end
end)

SliderFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        DraggingSlider = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if DraggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local mousePos = input.Position.X
        local sliderAbsPos = SliderFrame.AbsolutePosition.X
        local sliderWidth = SliderFrame.AbsoluteSize.X
        
        local relative = math.clamp((mousePos - sliderAbsPos) / sliderWidth, 0, 1)
        Power = math.floor(relative * 100)
        
        Fill.Size = UDim2.new(relative, 0, 1, 0)
        Label.Text = "Fling Power: " .. Power
    end
end)

-- ╔════════════════════════════════════════════╗
-- ║          THE UNHOLY PHYSICS ENGINE         ║
-- ╚════════════════════════════════════════════╝

local flingConnection
local isFlinging = false

local function startFling()
    if isFlinging then return end
    isFlinging = true
    
    humanoid.PlatformStand = true
    
    flingConnection = RunService.Heartbeat:Connect(function(dt)
        if not character or not rootPart or not rootPart.Parent then
            isFlinging = false
            return
        end
        
        local intensity = Power / 20
        local chaos = Vector3.new(
            math.random(-10,10) * intensity,
            math.random(5,18)   * intensity,
            math.random(-10,10) * intensity
        )
        
        rootPart.Velocity = chaos * 35 + Vector3.new(0, math.sin(tick()*8)*80*intensity, 0)
        rootPart.RotVelocity = Vector3.new(
            math.random(-200,200)*intensity,
            math.random(-300,300)*intensity,
            math.random(-200,200)*intensity
        )
        
        if math.random(1,8) == 1 then
            rootPart.AssemblyAngularVelocity += Vector3.new(
                math.random(-400,400),
                math.random(-600,600),
                math.random(-400,400)
            )
        end
    end)
end

local function stopFling()
    if not isFlinging then return end
    isFlinging = false
    if flingConnection then flingConnection:Disconnect() end
    
    humanoid.PlatformStand = false
    
    local tweenInfo = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(rootPart, tweenInfo, {Velocity = Vector3.new(0,0,0)}):Play()
end

