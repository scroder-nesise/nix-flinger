-- =============================================
--  MAIN FRAME DRAG
-- =============================================
DraggingSlider = false
local Power = 30
local DRAG_THRESHOLD = 4
local fDown, fDrag, fDS, fSP = false, false, nil, nil

for _, el in ipairs({Frame, header, Title, gearBtn, div, hint}) do
    pcall(function()
        el.InputBegan:Connect(function(input)
            local t = input.UserInputType
            if (t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch) and not DraggingSlider then
                fDown = true
                fDrag = false
                fDS   = input.Position
                fSP   = Frame.Position
            end
        end)
        el.InputEnded:Connect(function(input)
            local t = input.UserInputType
            if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
                fDown = false
                fDrag = false
            end
        end)
    end)
end

UserInputService.InputChanged:Connect(function(input)
    local t = input.UserInputType
    if not fDown or DraggingSlider then return end
    if t ~= Enum.UserInputType.MouseMovement and t ~= Enum.UserInputType.Touch then return end
    local delta = input.Position - fDS
    if not fDrag and (math.abs(delta.X) > DRAG_THRESHOLD or math.abs(delta.Y) > DRAG_THRESHOLD) then
        fDrag = true
    end
    if fDrag then
        Frame.Position = UDim2.new(fSP.X.Scale, fSP.X.Offset + delta.X, fSP.Y.Scale, fSP.Y.Offset + delta.Y)
    end
end)

