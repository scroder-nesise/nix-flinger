    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        DraggingSlider = true
    end
end)
SliderFrame.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        DraggingSlider = false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if not DraggingSlider then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end

    local rel = math.clamp((input.Position.X - SliderFrame.AbsolutePosition.X) / SliderFrame.AbsoluteSize.X, 0, 1)
    local mn  = tonumber(_G.SliderMin) or 1
    local mx  = tonumber(_G.SliderMax) or 250

    if mn > mx then mn, mx = mx, mn end

    Power           = math.floor(mn + rel * (mx - mn))
    Fill.Size       = UDim2.new(rel, 0, 1, 0)
    Label.Text      = "Power: " .. Power
    powerBadge.Text = tostring(Power)
end)

-- =============================================
--  FLING BURST
-- =============================================
local onCooldown = false
local flingConn  = nil   -- tracked so respawn can cancel it

local function doFlingBurst()
    if onCooldown then return end
    if not character or not rootPart or not rootPart.Parent then return end

    onCooldown = true
    setCooldownUI(true)

    local intensity = math.max(Power, 1) / 375

    if Settings.PlatformStand then humanoid.PlatformStand = true end
    humanoid:ChangeState(Enum.HumanoidStateType.Physics)

    -- BallSocket ragdoll (FE-visible)
    if Settings.Ragdoll then applyRagdoll(character) end

    rootPart.AssemblyLinearVelocity = Vector3.new(
        math.random(-Settings.Spread,  Settings.Spread)      * intensity,
        math.random(Settings.UpForce - 6, Settings.UpForce + 6) * intensity,
        math.random(-Settings.Spread,  Settings.Spread)      * intensity
    ) * 55

    rootPart.AssemblyAngularVelocity = Vector3.new(
        math.random(-1000, 1000) * intensity,
        math.random(-1500, 1500) * intensity,
        math.random(-1000, 1000) * intensity
    )

    local spinDuration  = Settings.SpinDuration + math.random() * 0.7
    local slowDuration  = Settings.SlowDuration
    local spinStart     = tick()
    local initialAngVel = rootPart.AssemblyAngularVelocity

    if flingConn then flingConn:Disconnect() end

    flingConn = RunService.Heartbeat:Connect(function()
        if not rootPart or not rootPart.Parent then
            flingConn:Disconnect()
            flingConn = nil
            return
        end

        local elapsed = tick() - spinStart

        if elapsed < spinDuration then
            -- air phase

        elseif elapsed < spinDuration + slowDuration then
            local t = (elapsed - spinDuration) / slowDuration
            t = t * t * (3 - 2 * t)
            rootPart.AssemblyAngularVelocity = initialAngVel:Lerp(Vector3.zero, t)

        else
            rootPart.AssemblyAngularVelocity = Vector3.zero
            flingConn:Disconnect()
            flingConn = nil

            if humanoid and humanoid.Parent then
                humanoid.PlatformStand = false

                if Settings.Ragdoll then
                    removeRagdoll(character)
                end

                if Settings.SitOnFling then
                    -- Wait until character actually lands before sitting.
                    -- Setting Sit while airborne gets ignored by the engine.
                    task.spawn(function()
                        local timeout = tick() + 5  -- give up after 5s
                        while tick() < timeout do
                            if not humanoid or not humanoid.Parent then return end
                            if humanoid.FloorMaterial ~= Enum.Material.Air then break end
                            task.wait()
                        end
                        if humanoid and humanoid.Parent then
                            humanoid.Sit = false
                            task.wait()
                            humanoid:ChangeState(Enum.HumanoidStateType.Physics)
                            task.wait()
                            humanoid.Sit = true
                            humanoid:ChangeState(Enum.HumanoidStateType.Seated)
                            Settings._sittingActive = true
                        end
                    end)
                else
                    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end

            task.delay(0.5, function()
                onCooldown = false
                setCooldownUI(false)
            end)
        end
    end)
end

ActionButton.MouseButton1Click:Connect(doFlingBurst)

-- [R] keybind
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.R then doFlingBurst() end
end)

-- Jump to stand
UserInputService.JumpRequest:Connect(function()
    if Settings.SitOnFling and Settings._sittingActive then
        if humanoid and humanoid.Parent then
            Settings._sittingActive = false
            humanoid.Sit = false
            task.wait()  -- one frame so Sit=false registers first
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

-- =============================================
--  CHARACTER RESET
-- =============================================
player.CharacterAdded:Connect(function(newChar)
    -- Cancel any in-flight fling heartbeat
    if flingConn then
        flingConn:Disconnect()
        flingConn = nil
    end

    -- Clean up BSC constraints on the OLD character
    if character then
        for _, v in ipairs(character:GetDescendants()) do
            if v.Name:sub(1, #BSC_TAG) == BSC_TAG then
                pcall(function() v:Destroy() end)
            end
        end
        for _, v in ipairs(character:GetDescendants()) do
            if v:IsA("Motor6D") then
                pcall(function() v.Enabled = true end)
            end
        end
    end

    -- Update refs
    character = newChar
    humanoid  = newChar:WaitForChild("Humanoid")
    rootPart  = newChar:WaitForChild("HumanoidRootPart")

    -- Reset all state
    onCooldown              = false
    Settings._sittingActive = false
    setCooldownUI(false)

    task.wait(0.1)
    if humanoid and humanoid.Parent then
        humanoid.PlatformStand = false
        humanoid.Sit           = false
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end)
