UserInputService.InputBegan:Connect(function(input, gp)

    if gp then return end

    if input.KeyCode == Enum.KeyCode.R then

        doFlingBurst()

    end

end)



local onCooldown = false



local function doFlingBurst()

    if onCooldown then return end

    if not character or not rootPart or not rootPart.Parent then return end



    onCooldown = true

    setCooldownUI(true)



    local intensity = math.max(Power, 1) / 375



    if Settings.PlatformStand then

        humanoid.PlatformStand = true

    end

    humanoid:ChangeState(Enum.HumanoidStateType.Physics)



    -- FE-visible ragdoll: disabling Motor6D replicates to all clients

    if Settings.Ragdoll then

        applyRagdoll(character)

    end



    rootPart.AssemblyLinearVelocity = Vector3.new(

        math.random(-Settings.Spread, Settings.Spread) * intensity,

        math.random(Settings.UpForce - 6, Settings.UpForce + 6) * intensity,

        math.random(-Settings.Spread, Settings.Spread) * intensity

    ) * 55



    rootPart.AssemblyAngularVelocity = Vector3.new(

        math.random(-1000, 1000) * intensity,

        math.random(-1500, 1500) * intensity,

        math.random(-1000, 1000) * intensity

    )



    local spinDuration  = Settings.SpinDuration + math.random() * 0.7

    local slowDuration  = Settings.SlowDuration

    local spinStart     = tick()

    local initialAngVel = rootPart.AssemblyAngularVelocity



    local conn

    conn = RunService.Heartbeat:Connect(function()

        if not rootPart or not rootPart.Parent then

            conn:Disconnect()

            return

        end



        local elapsed = tick() - spinStart



        if elapsed < spinDuration then

            -- air phase



        elseif elapsed < spinDuration + slowDuration then

            local t = (elapsed - spinDuration) / slowDuration

            t = t * t * (3 - 2 * t)

            rootPart.AssemblyAngularVelocity = initialAngVel:Lerp(Vector3.zero, t)



        else

            rootPart.AssemblyAngularVelocity = Vector3.zero

            conn:Disconnect()



            if humanoid and humanoid.Parent then

                humanoid.PlatformStand = false

                if Settings.Ragdoll then

                    removeRagdoll(character)

                end

                humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)

            end



            task.delay(0.5, function()

                onCooldown = false

                setCooldownUI(false)

            end)

        end

    end)

end



ActionButton.MouseButton1Click:Connect(doFlingBurst)



