-- ║       FE-VISIBLE RAGDOLL HELPERS           ║

-- ║  Motor6D.Enabled is replicated from client ║

-- ║  so other players see the effect.          ║

-- ╚════════════════════════════════════════════╝



local function applyRagdoll(char)

    for _, v in ipairs(char:GetDescendants()) do

        if v:IsA("Motor6D") then

            v.Enabled = false

        end

    end

end



local function removeRagdoll(char)

    for _, v in ipairs(char:GetDescendants()) do

        if v:IsA("Motor6D") then

            v.Enabled = true

        end

    end

end



